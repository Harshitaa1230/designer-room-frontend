# Base URL for the NestJS API consumed via Axios / React Query.
# The backend serves routes at its root (no /api prefix).
# Production uses /api so Vercel proxies the API on the app's own origin,
# keeping the auth cookies first-party (required by third-party cookie blocking).
VITE_API_URL=http://localhost:3000

# WhatsApp community/group invite shown on the waitlist success state.
VITE_WHATSAPP_LINK=https://chat.whatsapp.com/your-invite-code
