# Base URL for the NestJS API consumed via Axios / React Query.
# The backend serves routes at its root (no /api prefix).
# Production uses /api so Vercel proxies the API on the app's own origin,
# keeping the auth cookies first-party (required by third-party cookie blocking).
VITE_API_URL=http://localhost:3000

# WhatsApp community/group invite shown on the waitlist success state.
VITE_WHATSAPP_LINK=https://chat.whatsapp.com/your-invite-code

# ── Analytics ────────────────────────────────────────────────────────────────
# Set to "true" only in the production environment. The banner and all providers
# stay disabled everywhere else. At least one provider below must be configured.
VITE_ANALYTICS_ENABLED=false

# PostHog project API key (starts with phc_). Leave empty to disable PostHog.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable GA4.
VITE_GA4_ID=

# Cloudflare Web Analytics site token. Leave empty to disable Cloudflare.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=
